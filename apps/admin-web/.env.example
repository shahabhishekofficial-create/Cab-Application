# Public URL of the backend API used by the admin web app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Supabase browser credentials. Publishable/anon keys are safe for browser use; never use a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
